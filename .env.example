# ── TMDB ──────────────────────────────────────────────────────────────────────
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ncrawler:ncrawler@postgres:5432/ncrawler

# ── qBittorrent Web UI ────────────────────────────────────────────────────────
QBITTORRENT_HOST=qbittorrent
QBITTORRENT_PORT=8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# ── Library paths (mounted as Docker volumes) ─────────────────────────────────
MOVIES_ROOT=/library/movies
SERIES_ROOT=/library/series
DOWNLOADS_PATH=/downloads

# ── Scheduler ─────────────────────────────────────────────────────────────────
# How often to poll TMDB for new releases, in hours (168 = weekly)
DISCOVERY_INTERVAL_HOURS=168

# ── Quality ───────────────────────────────────────────────────────────────────
PREFERRED_QUALITY=1080p

# ── API Security ──────────────────────────────────────────────────────────────
# Leave empty to disable auth (development only).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=
